        print("Uso: python mercado_publico_downloader.py <URL_LICITACION> [-o CARPETA_SALIDA]")
        print("\\nEjemplo:")
        print('  python mercado_publico_downloader.py "https://www.mercadopublico.cl/Procurement/Modules/RFB/DetailsAcquisition.aspx?qs=iY4SYeZi3D9Zqn/AGgDB9Q=="')
        sys.exit(1)
    else:
        main()
